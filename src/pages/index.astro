---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import MarketingHomePage from '../components/react/MarketingHomePage';
import { getCarrierBoardDisplayItems } from '../lib/carrier-board-data';
import { pageMeta } from '../lib/page-meta';
import { jsonLdScript, webPageSchema } from '../lib/json-ld';
import { BRAND_NAME } from '../lib/site';
import {
  getHeroBgMode,
  HERO_FALLBACK_IMAGE,
  HERO_POSTER_SRC,
} from '../lib/hero';

const meta = pageMeta({
  title: 'Cannabis Export Air Freight Bangkok',
  description:
    'Licensed cannabis, hemp, and kratom export air freight from Bangkok — customs, partner GDP warehousing, partner ISO lab COA, and AI document intelligence.',
  path: '/',
});

const carrierItems = await getCarrierBoardDisplayItems();
const heroMode = getHeroBgMode();

const ld = jsonLdScript([
  webPageSchema({
    path: '/',
    name: `${BRAND_NAME} — Cannabis export air freight`,
    description:
      'Licensed cannabis, hemp, and kratom export air freight from Bangkok — customs, partner GDP warehousing, and validated cold chain.',
  }),
]);
---

<BaseLayout meta={meta} jsonLd={ld} showBreadcrumbNav={false}>
  <Fragment slot="head">
    {
      heroMode === 'video' ? (
        <link rel="preload" href={HERO_POSTER_SRC} as="image" />
      ) : (
        <link rel="preload" href={HERO_FALLBACK_IMAGE} as="image" />
      )
    }
  </Fragment>
  <HomeHero carrierItems={carrierItems} />
  <MarketingHomePage client:visible />
</BaseLayout>
