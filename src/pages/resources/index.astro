---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarketingPageHero from '../../components/MarketingPageHero.astro';
import ResourcesList from '../../components/react/ResourcesList';
import { getPublishedResources } from '../../lib/newsroom-data';
import { pageMeta } from '../../lib/page-meta';
import { absoluteUrl, BRAND_NAME } from '../../lib/site';
import { breadcrumbListSchema, itemListSchema, jsonLdScript, webPageSchema } from '../../lib/json-ld';
import { marketingHeroImages } from '../../data/marketing-hero-images';
import R2Preconnect from '../../components/R2Preconnect.astro';

const meta = pageMeta({
  title: 'Resources',
  description:
    'Long-form guides for Thailand medical cannabis export to Europe: B.E. 2568 licensing, GACP, EU-GMP Annex 7, QP batch release, GDP cold chain, and market access.',
  path: '/resources',
  ogImage: marketingHeroImages.resources.og,
  ogImageAlt: marketingHeroImages.resources.alt,
});

const raw = await getPublishedResources();
const resources = raw.map((item) => ({
  slug: item.slug,
  title: item.title,
  excerpt: item.excerpt,
  tags: item.tags || [],
  imageUrl: item.image_url || undefined,
}));
const allTags = Array.from(new Set(resources.flatMap((r) => r.tags))).sort();

const listItems = resources.map((r) => ({
  name: r.title,
  url: absoluteUrl(`/resources/${r.slug}`),
}));

const ld = jsonLdScript([
  webPageSchema({
    path: '/resources',
    name: `${BRAND_NAME} resource library`,
    description: 'Deep-dive articles on Thai controlled-herb export and EU GMP expectations.',
  }),
  ...(listItems.length ? [itemListSchema(`${BRAND_NAME} resources`, listItems)] : []),
]);

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  ...breadcrumbListSchema([
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources' },
  ]),
});
---

<BaseLayout meta={meta} jsonLd={ld} breadcrumbLd={breadcrumbLd}>
  <Fragment slot="head">
    <R2Preconnect />
    <link rel="preload" as="image" href={marketingHeroImages.resources.src} />
  </Fragment>
  <MarketingPageHero
    eyebrow="Resources"
    title="Resources"
    description="Long-form guides for regulated export, EU-GMP and QP expectations, GDP logistics, and EU market strategy."
    backgroundImage={marketingHeroImages.resources.src}
    backgroundImageAlt={marketingHeroImages.resources.alt}
    priority
  />
  <div class="marketing-container py-9 pb-[72px]">
    {
      resources.length === 0 ? (
        <p class="py-8 text-center" style="color: #9aa2aa;">No published guides yet.</p>
      ) : (
        <ResourcesList client:load resources={resources} allTags={allTags} />
      )
    }
  </div>
</BaseLayout>
