---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageMeta } from '../lib/page-meta';
import { jsonLdScript, webPageSchema } from '../lib/json-ld';

const meta = pageMeta({
  title: 'Page Not Found',
  description:
    'This page is unavailable. Browse OMG Experience services, regulatory resources, newsroom updates, or contact our Bangkok logistics team for air freight support.',
  path: '/404',
  forceNoindex: true,
});

const ld = jsonLdScript([
  webPageSchema({
    path: '/404',
    name: 'Page Not Found',
    description: meta.description,
  }),
]);
---

<BaseLayout meta={meta} jsonLd={ld} showBreadcrumbNav={false}>
  <div class="marketing-container flex min-h-[50vh] flex-col items-center justify-center py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide" style="color: var(--color-primary-ref)">404</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl" style="color: var(--ink)">Page not found</h1>
    <p class="mt-4 max-w-md text-lg" style="color: var(--muted)">
      That link may be outdated or mistyped. Try one of these instead:
    </p>
    <nav class="mt-8 flex flex-wrap justify-center gap-4 text-[15px] font-semibold">
      <a href="/" class="rounded-[var(--radius-sm)] px-4 py-2" style="color: var(--color-primary-ref)">Home</a>
      <a href="/services" class="rounded-[var(--radius-sm)] px-4 py-2" style="color: var(--color-primary-ref)">Services</a>
      <a href="/resources" class="rounded-[var(--radius-sm)] px-4 py-2" style="color: var(--color-primary-ref)">Resources</a>
      <a href="/contact" class="rounded-[var(--radius-sm)] px-4 py-2" style="color: var(--color-primary-ref)">Contact</a>
    </nav>
  </div>
</BaseLayout>
