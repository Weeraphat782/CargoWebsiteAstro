---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageMeta } from '../lib/page-meta';
import { breadcrumbListSchema, jsonLdScript, webPageSchema } from '../lib/json-ld';
import { BRAND_NAME, CONTACT_EMAIL } from '../lib/site';

const meta = pageMeta({
  title: 'Cookie Policy',
  description:
    'Cookies and similar technologies on omgcargo.tech — Google Tag Manager, Google Analytics, and local attribution storage keys explained for visitors.',
  path: '/cookie-policy',
});

const ld = jsonLdScript([
  webPageSchema({
    path: '/cookie-policy',
    name: `${BRAND_NAME} Cookie Policy`,
    description: 'Cookie and storage technologies on the marketing website.',
  }),
]);

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  ...breadcrumbListSchema([
    { name: 'Home', path: '/' },
    { name: 'Cookie Policy', path: '/cookie-policy' },
  ]),
});

const updated = '31 July 2026';
---

<BaseLayout meta={meta} jsonLd={ld} breadcrumbLd={breadcrumbLd}>
  <div class="marketing-container max-w-3xl py-14 pb-[72px]">
    <h1 class="font-display text-3xl font-bold" style="color: var(--navy-950);">Cookie Policy</h1>
    <p class="mt-2 text-sm" style="color: var(--muted);">Last updated: {updated}</p>

    <p class="mt-6 text-[15px] leading-relaxed" style="color: var(--ink);">
      This policy explains how {BRAND_NAME} uses cookies and similar browser storage on
      <strong>www.omgcargo.tech</strong>. See also our
      <a href="/privacy-policy" class="underline">Privacy Policy</a>.
    </p>

    <h2 class="font-display mt-10 text-xl font-bold" style="color: var(--navy-950);">What we use</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[480px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-[var(--line)]" style="color: var(--navy-700);">
            <th class="py-2 pr-4 font-semibold">Name / provider</th>
            <th class="py-2 pr-4 font-semibold">Type</th>
            <th class="py-2 font-semibold">Purpose</th>
          </tr>
        </thead>
        <tbody class="text-[14px]" style="color: var(--ink);">
          <tr class="border-b border-[var(--line)]">
            <td class="py-3 pr-4">Google Tag Manager</td>
            <td class="py-3 pr-4">Cookie / tag</td>
            <td class="py-3">Loads analytics and conversion tags configured in GTM</td>
          </tr>
          <tr class="border-b border-[var(--line)]">
            <td class="py-3 pr-4">Google Analytics (_ga, _ga_*)</td>
            <td class="py-3 pr-4">Cookie</td>
            <td class="py-3">Aggregated visit statistics and key events (e.g. generate_lead)</td>
          </tr>
          <tr class="border-b border-[var(--line)]">
            <td class="py-3 pr-4">omgexp_attr_first / omgexp_attr_last</td>
            <td class="py-3 pr-4">localStorage</td>
            <td class="py-3">First/last-touch UTM and click-id attribution for enquiry reporting</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="font-display mt-10 text-xl font-bold" style="color: var(--navy-950);">Managing preferences</h2>
    <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--ink);">
      You can block or delete cookies in your browser settings. Blocking analytics cookies will not prevent you from
      using the site, but we will have less insight into how visitors find us. To clear attribution storage, remove
      site data for www.omgcargo.tech in your browser.
    </p>

    <h2 class="font-display mt-10 text-xl font-bold" style="color: var(--navy-950);">Contact</h2>
    <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--ink);">
      Questions: <a href={`mailto:${CONTACT_EMAIL}`} class="underline">{CONTACT_EMAIL}</a>.
    </p>

    <p class="mt-10 rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--paper-muted)] p-4 text-sm" style="color: var(--muted);">
      <strong>Draft notice:</strong> Align cookie names with your live GTM/GA4 container after legal review.
    </p>
  </div>
</BaseLayout>
